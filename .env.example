# Standalone backend / browser development only. Electron generates a session token.
EDGE_BACKEND_TOKEN=replace-with-a-random-token
EDGE_DATA_DIR=./data
EDGE_PORT=8765
EDGE_EMBEDDING_MODEL=google/embeddinggemma-2
# Inference always uses prepared local weights; cloud generation is separate.
EDGE_MODEL_OFFLINE=false
# Optional: reuse a prepared local snapshot from another data directory.
# EDGE_EMBEDDING_MODEL_PATH=/absolute/path/data/models/embeddinggemma-2
EDGE_IMAGE_EMBEDDINGS=true
DEEPSEEK_API_KEY=

# Optional local generation: existing GGUF weights; never downloaded automatically.
# EDGE_LOCAL_MODEL_PATH=/absolute/path/MiniCPM5-2B-Q4_K_M.gguf
# EDGE_LOCAL_SERVER_PATH=/absolute/path/llama-server
